---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Menu from '../components/Menu.astro';
import SiteNav from '../components/SiteNav.astro';
import StickyHeader from '../components/StickyHeader.astro';
import FeaturedArticle from '../components/FeaturedArticle.astro';
import Sidebar from '../components/Sidebar.astro';
import Starfield from '../components/Starfield.astro';

const project = await getCollection('project', ({ data }) => !data.draft);
const article = await getCollection('article', ({ data }) => !data.draft);

const pinned = project[0];
project.sort((a, b) => +b.data.date - +a.data.date);
---
<Starfield /> 
<BaseLayout>
  <SiteNav mobileOnly />
  <div class="blog">
    <Menu />
    <StickyHeader
      title="dsgn"
      pinnedLabel="systemic innovation"
      pageNumber="scroll to see more projects"
    />

    <div class="blog-header-container">
      {
        project.map((post) => (
          <FeaturedArticle
            bigTitle={post.data.bigTitle}
            date={post.data.date}
            emphasis={post.data.emphasis}
            headline={post.data.headline}
            cover={post.data.cover}
            author={post.data.author}
            context={post.data.context}
            excerpt={post.data.excerpt}
            href={`/portfolio/${post.id}`}
            accentColor={post.data.accentColor}
          />
        ))
      }
    </div>

    <Sidebar entries={article}/>
  </div>
</BaseLayout>
