---
import { getCollection, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import ProjectToc from '../../components/ProjectToc.astro';

export async function getStaticPaths() {
  const project = (await getCollection('project', ({ data }) => !data.draft)).sort(
    (a, b) => +b.data.date - +a.data.date,
  );

  return project.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: project[i + 1],
      next: project[i - 1],
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);

---

<PageLayout
  title={post.data.bigTitle}
  description={post.data.excerpt}
  eyebrow={post.data.pageNumber ?? 'Essay'}
  pageTitle={`${post.data.title} — Self Esteem`}
  accentColor={post.data.accentColor}
>
  
  {
    post.data.tags.length > 0 && (
      <div class="tag-list" style="margin-top: 24px;">
        {post.data.tags.map((tag) => (
          <a href={`/tags/${tag}`}>{tag}</a>
        ))}
      </div>
    )
  }

  <hr style="border:0;border-top:1px solid #94918f;margin:32px 0;" />
  
  <img src={post.data.cover}>

  <ProjectToc headings={headings} accentColor={post.data.accentColor} />

  <div class="prose">
    <Content />
  </div>

  <hr style="border:0;border-top:1px solid #94918f;margin:32px 0;" />

  <div class="post-meta">
    <span style="display: flex; gap: 3rem;"> 
      <span> <b style="font-style: normal; font-family: 'Space Grotesk', sans-serif;"> WHEN: </b> {post.data.time}</span>
      <span> <b style="font-style: normal; font-family: 'Space Grotesk', sans-serif;"> WHERE: </b> {post.data.context}</span>
    </span>
    <span style="white-space: pre-wrap;"><b style="font-style: normal; font-family: 'Space Grotesk', sans-serif;">WHO: </b> {post.data.author}</span>
  </div>

  <nav class="post-nav" aria-label="Adjacent essays">
    {
      prev ? (
        <a class="post-nav__prev" href={`/portfolio/${prev.id}`}>
          <span>← Previous</span>
          <strong>{prev.data.bigTitle}</strong>
        </a>
      ) : (
        <span />
      )
    }
    {
      next ? (
        <a class="post-nav__next" href={`/portfolio/${next.id}`}>
          <span>Next →</span>
          <strong>{next.data.bigTitle}</strong>
        </a>
      ) : (
        <span />
      )
    }
  </nav>
</PageLayout>
