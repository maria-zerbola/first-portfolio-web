---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Starfield from '../../components/Starfield.astro';

const project = (await getCollection('project', ({ data }) => !data.draft)).sort(
  (a, b) => +b.data.date - +a.data.date,
);

const allTags = [...new Set(project.flatMap((p) => p.data.tags))].sort();

const fmt = (d: Date) =>
  `${String(d.getDate()).padStart(2, '0')}.${String(d.getMonth() + 1).padStart(2, '0')}.${d.getFullYear()}`;

const renderHeadline = (headline: string, emphasis?: string) => {
  if (!emphasis) return headline;
  return headline.replace('{emphasis}', `__${emphasis}__`);
};
---

<PageLayout
  title="My works"
  eyebrow="Portfolio"
  description="Personal and academic product service system design projects"
>
  {
    allTags.length > 0 && (
      <div class="tag-scroller">
        <button
          class="tag-scroller__arrow tag-scroller__arrow--left"
          aria-label="Scorri a sinistra"
        >
          ←
        </button>
        <nav class="tag-list tag-scroller__track">
          {allTags.map((tag) => (
            <a href={`/tags/${tag}`}>{tag}</a>
          ))}
        </nav>
        <button class="tag-scroller__arrow tag-scroller__arrow--right" aria-label="Scorri a destra">
          →
        </button>
      </div>
    )
  }

  <script>
    document.querySelectorAll('.tag-scroller').forEach((scroller) => {
      const track = scroller.querySelector('.tag-scroller__track');
      const left = scroller.querySelector('.tag-scroller__arrow--left');
      const right = scroller.querySelector('.tag-scroller__arrow--right');
      if (!track || !left || !right) return;

      const update = () => {
        left.classList.toggle('is-hidden', track.scrollLeft <= 0);
        right.classList.toggle(
          'is-hidden',
          track.scrollLeft + track.clientWidth >= track.scrollWidth - 1,
        );
      };

      left.addEventListener('click', () => track.scrollBy({ left: -200, behavior: 'smooth' }));
      right.addEventListener('click', () => track.scrollBy({ left: 200, behavior: 'smooth' }));
      track.addEventListener('scroll', update);
      window.addEventListener('resize', update);
      update();
    });
  </script>

  <div class="post-list">
    {
      project.map((post) => {
        const parts = renderHeadline(post.data.headline, post.data.emphasis).split('__');
        return (
          <a class="post-card" href={`/portfolio/${post.id}`}>
            <div class="post-card__cover">
              <img src={post.data.cover} alt="" loading="lazy" />
            </div>
            <div>
              <h2 class="post-card__title">
                {parts.map((part, i) => (i % 2 === 1 ? <span>{part}</span> : <>{part}</>))}
              </h2>
              <p class="post-card__excerpt">{post.data.excerpt}</p>
              {post.data.tags.length > 0 && (
                <div class="post-card__tags">
                  {post.data.tags.map((tag) => (
                    <span>{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </a>
        );
      })
    }
  </div>
</PageLayout>
<Starfield />
