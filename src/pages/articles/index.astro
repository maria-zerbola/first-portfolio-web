---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

const articles = (await getCollection('article')).sort((a, b) => a.data.order - b.data.order);
---

<PageLayout
  title="Articles"
  eyebrow="Some thoughts"
  description="What's been on my mind lately, reflections on my work"
>
  {
    (
      <div class="work-grid">
        {articles.map((item) => {
          const Tag = item.id ? 'a' : 'div';
          return (
            <Tag
              class="work-item"
              href={`/articles/${item.id}`}
              target={item.data.url ? '_blank' : undefined}
              rel={item.data.url ? 'noopener' : undefined}
            >
              <img src={item.data.cover} alt="" loading="lazy" />
              <div class="work-item__year">{item.data.year}</div>
              <div class="work-item__title">{item.data.title}</div>
              <div class="work-item__summary">{item.data.summary}</div>
            </Tag>
          );
        })}
      </div>
    )
  }
</PageLayout>
