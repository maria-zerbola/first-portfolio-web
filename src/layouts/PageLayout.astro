---
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';
import SiteNav from '../components/SiteNav.astro';

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  heroImage?: string;
  pageTitle?: string;
  accentColor?: string;
}

const { title, description, eyebrow, heroImage, pageTitle, accentColor } = Astro.props;
const headTitle = pageTitle ?? `${title} — Maria Zerbola`;
---

<BaseLayout title={headTitle} description={description} image={heroImage} accentColor={accentColor}>
  <div class="page">
    <SiteNav />

    <main class="page-main">
      
      <section class="page-head" id="top">
        {eyebrow && <div class="page-eyebrow">{eyebrow}</div>}
        <h1 class="page-title">{title}</h1>
        {description && <p class="page-deck">{description}</p>}
      </section>

      {
        heroImage && (
          <div class="page-hero">
            <img src={heroImage} alt="" class="hero-bg" />
          </div>
        )
      }

      <div class="page-body">
        <slot />
      </div>
    </main>

    <Footer />
  </div>
</BaseLayout>
 
