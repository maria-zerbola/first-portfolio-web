---
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  heroImage?: string;
  pageTitle?: string;
  accentColor?: string;
}

const { title, description, eyebrow, heroImage, pageTitle, accentColor } = Astro.props;
const headTitle = pageTitle ?? `${title} — Maria Zerbola`;
---

<BaseLayout title={headTitle} description={description} image={heroImage} accentColor={accentColor}>
  <div class="page">
    <header class="page-nav">
      <a class="page-nav__brand" href="/"><span>MariaZerbola</span> Portfolio</a>
      <nav aria-label="Primary">
        <a href="/portfolio">Portfolio</a>
        <a href="/articles">Articles</a>
        <a href="/about_me">About me</a>
        <a
          href="https://www.linkedin.com/in/mariazerbola"
          target="_blank"
          rel="noopener noreferrer"
          class="linkedin-link"
          aria-label="Profilo LinkedIn"
          style="align-self: center;"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" data-astro-cid-2j44jlrm="" fill="$subtitle-color" style="border-radius: inherit;"> 
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" data-astro-cid-2j44jlrm=""></path>
          </svg>
        </a>
        <a
          href="mailto:mariazerbola.design@gmail.com"
          target="_blank"
          rel="noopener noreferrer"
          class="email-link"
          aria-label="email address"
        >
          <svg viewBox="0 0 8 8" width="35" aria-hidden="true" data-astro-cid-2j44jlrm="" fill="$subtitle-color" style="background-color: white;padding: 3px 1px 0px; border-radius: inherit;" height="25"> 
            <path d="m0 0h8v6h-8zm.75 .75v4.5h6.5v-4.5zM0 0l4 3 4-3v1l-4 3-4-3z" data-astro-cid-2j44jlrm=""></path> 
          </svg>
        </a>
      </nav> 
    </header>

    <main class="page-main">
      
      <section class="page-head" id="top">
        {eyebrow && <div class="page-eyebrow">{eyebrow}</div>}
        <h1 class="page-title">{title}</h1>
        {description && <p class="page-deck">{description}</p>}
      </section>

      {
        heroImage && (
          <div class="page-hero">
            <img src={heroImage} alt="" class="hero-bg" />
          </div>
        )
      }

      <div class="page-body">
        <slot />
      </div>
    </main>

    <Footer />
  </div>
</BaseLayout>
