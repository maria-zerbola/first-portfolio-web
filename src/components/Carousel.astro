---
interface Props {
  slides: Array<{ image: string; text: string }>;
}

const { slides } = Astro.props;
---

<div class="carousel-container">
  <div class="carousel-display"> 
    <div class="carousel-track" id="carouselTrack">
      {slides.map((slide) => (
        <img src={slide.image} alt={slide.text} />
      ))}
    </div>
  </div>
    
  
  <div class="carousel-text-wrapper">
    <div class="carousel-text-section">
      <p id="currentText">{slides[0].text}</p>
    </div>
    <div class="carousel-buttons">
        <button class="carousel-btn prev" id="prevBtn">←</button>
        <div class="carousel-dots" id="dotsContainer">
          {slides.map((_, index) => (
            <button class="dot" data-index={index}></button>
          ))}
        </div>
        <button class="carousel-btn next" id="nextBtn">→</button>
    </div>
  </div>    
</div>

<style>
  .carousel-container {
    display: flex;
    gap: 2rem;
    margin: 0rem 0;
    align-items: start;
    
    

    @media screen and (max-width: 560px){
      display: grid;
    }
  }

  .carousel-display {
    flex: 1;
    overflow: hidden;
    border-radius: 8px;
    min-width: 200px;
  }

  .carousel-text-wrapper {
    flex: 0 0 68%;
    min-width: 0;
    padding: 1rem;
    border-radius: 8px;
    display: grid;
    align-items: start;
  }

  .carousel-track {
    display: flex;
    transition: transform 0.5s ease-in-out;
  }

  .carousel-track img {
    min-width: 100%;
    flex-shrink: 0;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .carousel-buttons {
    display: flex;
    gap: 1rem;
    justify-content: left;
    margin-top: 1rem;
  }

  .carousel-btn {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    border: 2px solid #333;
    background: white;
    font-size: 1.5rem;
    cursor: pointer;
    transition: all 0.3s;
  }

  .carousel-btn:hover {
    background: #333;
    color: white;
  }

  .carousel-dots {
  display: flex;
  gap: 0.5rem;
  align-items: center;
  }

  .dot {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: none;
    background: var(--accent, #cbcdcc);
    opacity: 0.6;
    cursor: pointer;
    transition: background 0.3s;
  }

  .dot.active {
    width: 45px;
    height: 45px;
    background: transparent;
    border: 2px solid #333;

  }

  .carousel-text-section {
    flex: 0 0 55%;
    padding: 0rem;
    border-radius: 8px;
    display: flex;
    align-items: start;
  }

  #currentText {
    font-size: 1.2rem;
    line-height: 1.6;
    margin: 0;
  }
</style>

<script>
  const track = document.getElementById("carouselTrack");
  const prevBtn = document.getElementById("prevBtn");
  const nextBtn = document.getElementById("nextBtn");
  const textBox = document.getElementById("currentText");
  const dots = document.querySelectorAll(".dot");
  
  let currentIndex = 0;
  const imgs = track?.querySelectorAll("img") || [];
  const totalSlides = imgs.length;
  const slides = Array.from(imgs).map(img => ({ text: img.alt }));

  function updateCarousel() {
    track!.style.transform = `translateX(-${currentIndex * 100}%)`;
    textBox!.textContent = slides[currentIndex].text;
    dots.forEach((dot, index) => {
      dot.classList.toggle("active", index === currentIndex);
    });
  }

  dots.forEach((dot) => {
    dot.addEventListener("click", (e) => {
      currentIndex = parseInt((e.target as HTMLElement).dataset.index!);
      updateCarousel();
    });
  });

  prevBtn?.addEventListener("click", () => {
    currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
    updateCarousel();
  });

  nextBtn?.addEventListener("click", () => {
    currentIndex = (currentIndex + 1) % totalSlides;
    updateCarousel();
  });
</script>