---
interface Props {
  bigTitle: string;
  date: Date;
  emphasis?: string;
  headline: string;
  cover: string;
  author: string;
  context: string;
  excerpt: string;
  href: string;
  accentColor: string;
}

const { bigTitle, date, emphasis, headline, cover, author, context, excerpt, href, accentColor } = Astro.props;

const formatted = new Intl.DateTimeFormat('en-GB', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
})
  .format(date)
  .replaceAll('/', '.');

const parts = emphasis ? headline.split('{emphasis}') : [headline];
---

<div class="blog-header" style={`--accent: ${accentColor}`}>
  <div class="blog-article header-article">
    <div class="blog-big__title" href={href}>{bigTitle}</div>
    <hr style="margin-top: 53px; border:0; border-top: 1px solid #94918f;"/>
  </div>
  <div class="blog-article">
    <img src={cover} alt={bigTitle} />
    <a href={href} style="text-decoration: none; color: inherit; border:0; display:grid;">
      <h2>
        {
          emphasis ? (
            <>
              {parts[0]}
              <span>{emphasis}</span>
              {parts[1]}
            </>
          ) : (
            headline
          )
        }
      </h2>
    </a>
    <div class="blog-detail">
      <span>{context}</span>
    </div>
    <p>{excerpt}</p>
    <a class="arrow" href={href}>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="feather feather-corner-down-right"
        viewBox="0 0 24 24"
      >
        <path d="M15 10l5 5-5 5"></path>
        <path d="M4 4v7a4 4 0 004 4h12"></path>
      </svg>
      See More
    </a>
  </div>
</div>

<style>
  .blog-article p {
    @media screen and (max-width: 560px) {
      display: none;
    }
  }

  .blog-detail span {
     @media screen and (max-width: 560px) {
      padding-bottom: 1rem;
      border-bottom: 1px solid #94918f;
      margin-bottom: 2rem;
    }
  }

  .blog-article a {
    @media screen and (max-width: 560px) {
      padding-bottom: 14px;
    }
  }
  
  .arrow {
    @media screen and (max-width: 560px) {
      display: none;
    }
  }
</style>