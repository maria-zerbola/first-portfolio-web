---
interface Props {
  title?: string;
  subtitle?: string;
  cta?: string;
}

const {
  title = 'Designing for a good life',
  subtitle = 'physical, mental, spiritual and socio-economic wellbeing',
  cta = 'sustainably',
} = Astro.props;
---

<div class="circle">
  <div class="circle-title">{title}</div>
  <div class="circle-subtitle">{subtitle}</div>
  <div class="circle-footer">{cta}</div>
</div>
