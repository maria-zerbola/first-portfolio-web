---
const count = 200;
---

<div class="starfield">
  {Array.from({ length: count }, (_, i) => (
    <span class="star" data-index={i}></span>
  ))}
</div>

<style>
  .starfield {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    overflow: hidden;
    background: linear-gradient(to bottom, #f9fff0 0%, #f9fff0 100%);
  }

  .star {
    position: absolute;
    top: 0;
    left: 0;
    color: #121813;
    font-size: 14px;
    font-family: monospace;
    user-select: none;
    pointer-events: none;
    opacity: 0;
    will-change: transform;
    transition: opacity 1s ease;
  }
</style>

<script>
  const stars = Array.from(document.querySelectorAll('.star'));
  const chars = ['*', '.', '·', ':'];

  const isMobile = window.innerWidth <= 768;
  const maxVisible = isMobile ? 100 : stars.length;

  // Stato del mouse
  const mouse = { x: -9999, y: -9999 };
  window.addEventListener('mousemove', (e) => {
    mouse.x = e.clientX;
    mouse.y = e.clientY;
  });
  window.addEventListener('mouseleave', () => {
    mouse.x = -9999;
    mouse.y = -9999;
  });

  const REPEL_RADIUS = 120;   // raggio d'influenza del mouse (px)
  const REPEL_STRENGTH = 60;  // quanto si spostano le particelle (px)

  const particles = stars.map((el, index) => {
    if (index >= maxVisible) {
      el.style.display = 'none';
      return null;
    }

    const baseX = Math.random() * window.innerWidth;
    const baseY = Math.random() * window.innerHeight;

    el.textContent = chars[Math.floor(Math.random() * chars.length)];

    // avvia il fade-in
    requestAnimationFrame(() => { el.style.opacity = '0.5'; });

    return {
      el,
      baseX,
      baseY,
      // parametri per il floating "organico" (somma di sinusoidi)
      freq1: 0.2 + Math.random() * 0.3,
      freq2: 0.15 + Math.random() * 0.25,
      phase1: Math.random() * Math.PI * 2,
      phase2: Math.random() * Math.PI * 2,
      ampX: 60 + Math.random() * 80,
      ampY: 60 + Math.random() * 80,
      // smoothing per la repulsione (evita scatti)
      offsetX: 0,
      offsetY: 0,
    };
  }).filter(Boolean);

  let t = 0;

  function animate() {
    t += 0.01;

    for (const p of particles) {
      // Posizione "naturale" di floating (senza mouse)
      const floatX = Math.sin(t * p.freq1 + p.phase1) * p.ampX;
      const floatY = Math.cos(t * p.freq2 + p.phase2) * p.ampY;

      const currentX = p.baseX + floatX;
      const currentY = p.baseY + floatY;

      // Repulsione dal mouse
      const dx = currentX - mouse.x;
      const dy = currentY - mouse.y;
      const dist = Math.sqrt(dx * dx + dy * dy);

      let repelX = 0;
      let repelY = 0;
      if (dist < REPEL_RADIUS) {
        const force = (1 - dist / REPEL_RADIUS) * REPEL_STRENGTH;
        const angle = Math.atan2(dy, dx);
        repelX = Math.cos(angle) * force;
        repelY = Math.sin(angle) * force;
      }

      // Smoothing: l'offset "insegue" il target invece di saltarci sopra
      p.offsetX += (repelX - p.offsetX) * 0.1;
      p.offsetY += (repelY - p.offsetY) * 0.1;

      const finalX = currentX + p.offsetX;
      const finalY = currentY + p.offsetY;

      p.el.style.transform = `translate(${finalX}px, ${finalY}px)`;
    }

    requestAnimationFrame(animate);
  }

  animate();

  // Riposiziona basePosition al resize per evitare che escano dallo schermo
  window.addEventListener('resize', () => {
    for (const p of particles) {
      p.baseX = Math.min(p.baseX, window.innerWidth);
      p.baseY = Math.min(p.baseY, window.innerHeight);
    }
  });
</script>