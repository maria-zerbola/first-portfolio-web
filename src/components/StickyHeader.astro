---
interface Props {
  title: string;
  pinnedLabel?: string;
  pageNumber?: string;
}

const { title, pinnedLabel = 'Pinned Issue', pageNumber = 'MZ' } = Astro.props;
---

<div class="blog-header blog-is-sticky">
  <div class="blog-article header-article">
    <div class="blog-big__title">{title}</div>
    <div class="blog-menu rounded small-title">{pinnedLabel}</div>
  </div>
  <div class="blog-article page-number">
    {pageNumber}
  </div>
</div>

<div class="prose intro">
  <h2 style="font-family: 'Playfair Display', serif; margin-top:0px;">Welcome</h2>
  <p>
    I explore interdiscipinary design projects and business management, with the goal of improving
    our collective quality of life, systemically and sustainably. Have a look around!
  </p>
</div>
