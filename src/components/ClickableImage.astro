---
interface Props {
  text: string;
  imageSrc: string;
  alt?: string;
}
const { text, imageSrc, alt = 'Immagine' } = Astro.props;
---
<button class="clickable-trigger" data-image-src={imageSrc} data-image-alt={alt}>
  {text}
</button>
<style>
  .clickable-trigger {
    display: inline-flex;
    align-items: center;
    vertical-align: baseline;
    background: none;
    border: none;
    color: inherit;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 20%;
    padding: 0;
    font-size: inherit;
    transition: opacity 0.2s;
    font-weight: bold;
  }
  .clickable-trigger:hover {
    opacity: 0.7;
    color: var(--accent);
  }
</style>
<script>
  // Un solo listener globale per tutti i bottoni della pagina
  if (!window.__clickableImageInit) {
    window.__clickableImageInit = true;
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.clickable-trigger');
      if (!btn) return;
      window.dispatchEvent(new CustomEvent('open-image-modal', {
        detail: {
          src: btn.dataset.imageSrc,
          alt: btn.dataset.imageAlt,
        },
      }));
    });
  }
</script>