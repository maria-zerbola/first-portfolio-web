---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  accentColor: string;
}

const { headings, accentColor } = Astro.props;

// Solo i titoli "####" (depth 4) diventano voci dell'indice
const items = headings.filter((h) => h.depth === 4);

const raggio = 55;
const circonferenza = 2 * Math.PI * raggio;
---

{
  items.length > 0 && (
    <nav class="project-toc" aria-label="Indice del progetto">
      <ul>
        {items.map((item) => {
          const buco = item.text.length * 7;
          const pieno = circonferenza - buco;
          return (
            <li>
              <a href={`#${item.slug}`}>
                <svg width="120" height="120" viewBox="0 0 120 120">
                  <circle cx="60" cy="60" r="25" fill={accentColor} />
                  <circle
                    cx="60"
                    cy="60"
                    r={raggio}
                    fill="none"
                    stroke="#000"
                    stroke-width="1.5"
                    stroke-dasharray={`${pieno} ${buco}`}
                    transform="rotate(140 60 60)"
                  />
                  <path
                    id={`curva-${item.slug}`}
                    d={`M ${60 - raggio} 60 A ${raggio} ${raggio} 0 1 0 59.9 ${60 - raggio}`}
                    fill="none"
                    transform="rotate(-48 60 60)"
                  />
                  <text font-size="12" font-weight="bold">
                    <textPath href={`#curva-${item.slug}`} startOffset="0%">
                      {item.text}
                    </textPath>
                  </text>
                </svg>
              </a>
            </li>
          );
        })}
      </ul>
      <a href="#top" class="project-toc__top">
        <text font-size="12" font-weight="bold">
          {' '}
          TOP{' '}
        </text>
        <svg width="120" height="40" viewBox="0 0 120 40">
          <circle
            cx="60"
            cy="-30"
            r={raggio}
            fill="none"
            stroke="#000"
            stroke-width="1.5"
            transform="rotate(0 60 60)"
          />
        </svg>
      </a>
    </nav>
  )
}

<style lang="scss">
  .project-toc {
    position: fixed;
    top: 50%;
    right: 7%;
    transform: translateY(-50%);
    z-index: 8;
    max-width: 180px;
    display: flex;
    flex-direction: column;
    gap: 10px;

    &__label {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 11px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: #94918f;
      margin-bottom: 4px;
    }

    ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    &__top {
      display: grid;
      margin-top: 30px;
      font-family: 'Inter', sans-serif;
      font-size: 12px;
      color: #94918f;
      text-decoration: none;
      text-align: center;

      &:hover {
        color: #121418;
      }
    }

    a {
      display: grid;
      font-family: 'Inter', sans-serif;
      font-size: 14px;
      line-height: 1.3;
      color: #121418;
      text-decoration: none;
      padding-right: 10px;
      opacity: 0.6;
      transition:
        opacity 0.2s ease,
        border-color 0.2s ease;

      &:hover {
        opacity: 1;
        border-color: #121418;
      }
    }
  }

  @media (max-width: 1100px) {
    .project-toc {
      display: none;
    }
  }
</style>
